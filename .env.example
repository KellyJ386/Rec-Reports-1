# Preferred names. The NEXT_PUBLIC_* prefix is a holdover from an abandoned
# Next.js stack; those names still work as one-release fallbacks (see
# src/lib/env.mjs) but are deprecated and will be removed in a future release.
APP_URL=http://localhost:3000
SUPABASE_URL=https://example-project.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
SUPABASE_JWT_SECRET=replace-with-server-only-jwt-secret
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
OBSERVABILITY_DSN=https://example.invalid/observability

# Optional. Bearer secret guarding POST/GET /api/v1/internal/notifications/drain
# (scripts/server.mjs -> src/lib/http/internal-routes.mjs). Unset = the route
# returns 503 (disabled), never open. Vercel sets this automatically as the
# cron request's Authorization header when a project env var named exactly
# CRON_SECRET is configured -- see the "crons" block in vercel.json.
CRON_SECRET=replace-with-server-only-cron-secret

# Optional. Name of the private Supabase Storage bucket used by
# src/lib/storage.mjs (see supabase/migrations/0030_storage.sql). Defaults to
# "attachments" when unset.
SUPABASE_STORAGE_BUCKET=attachments

# Optional. Overrides the production detail-leak guard on the generic 500
# response (scripts/server.mjs / api/[...path].mjs): Vercel sets
# VERCEL_ENV=production automatically on a production deployment, which hides
# error.message from the response body there unless DEBUG_ERRORS is also set
# to a non-empty value other than "false"/"0". Leave unset in normal
# production use; set temporarily on a preview/production deployment while
# debugging a specific incident, then unset it again. VERCEL_ENV itself is
# set automatically by Vercel and should never be set here.
DEBUG_ERRORS=

# Optional (P-4, src/lib/notifications/email.mjs + adapters.mjs). Selects the
# worker's email delivery adapter. Unset or "noop" -> every email delivery is
# marked 'sent' with no network call (the default). "resend" requires
# EMAIL_API_KEY and EMAIL_FROM below to also be set, or the adapter throws at
# build time. Any other value throws.
EMAIL_PROVIDER=noop

# Required when EMAIL_PROVIDER=resend. Resend API key, sent as
# `Authorization: Bearer` on every POST https://api.resend.com/emails call.
EMAIL_API_KEY=replace-with-server-only-resend-api-key

# Required when EMAIL_PROVIDER=resend. The verified "From" address/name
# Resend sends every notification email as.
EMAIL_FROM=replace-with-verified-sender-address

# Optional (P-5, src/lib/notifications/fcm.mjs + adapters.mjs). Selects the
# worker's push delivery adapter. Unset or "noop" -> every push delivery is
# marked 'sent' with no network call (the default). "fcm" requires
# FCM_SERVICE_ACCOUNT_JSON below to also be set, or the adapter throws at
# build time. Any other value throws.
PUSH_PROVIDER=noop

# Required when PUSH_PROVIDER=fcm. Base64-encoded Firebase/Google Cloud
# service-account JSON (client_email, private_key, project_id, token_uri) --
# base64 because the raw JSON embeds a multi-line PEM private key, which is
# not safe to carry as a literal env var value. Used to mint the OAuth2
# access token FCM HTTP v1 requires; never sent to the browser.
FCM_SERVICE_ACCOUNT_JSON=replace-with-server-only-base64-fcm-service-account-json

# Optional (P-5, scripts/server.mjs's GET /api/v1/public-config). The
# owner-supplied Firebase Web SDK config object (apiKey, authDomain,
# projectId, messagingSenderId, appId, ...) as a raw JSON string -- unlike
# FCM_SERVICE_ACCOUNT_JSON above this is NOT base64 and carries no secret; it
# is the same public client config Firebase's own docs say is safe to ship to
# the browser. Unset -> the "Enable notifications" button in
# src/public/js/app.js stays hidden.
FIREBASE_WEB_CONFIG_JSON=replace-with-firebase-web-sdk-config-json
